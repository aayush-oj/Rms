# RestroX / RMS runtime configuration template.
# Copy to .env in the protected application root and replace every placeholder.
# Never commit a populated production .env file.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=replace-with-database-name
DATABASE_USER=replace-with-database-user
DATABASE_PASSWORD=replace-with-a-strong-database-password
DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT_MS=5000

UPLOADS_DIR=/home/replace-with-cpanel-user/rms-data/uploads

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h
PLATFORM_JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
PLATFORM_JWT_EXPIRES_IN=8h

ALLOWED_ORIGINS=https://replace-with-your-rms-domain
COOKIE_SECURE=true
TRUST_PROXY=true
LEGACY_STATE_ENABLED=false

SUPPORT_CONTACT_NAME=RestroX Support
SUPPORT_CONTACT_EMAIL=replace-with-support-email
SUPPORT_CONTACT_WEBSITE=https://replace-with-support-website
SUPPORT_CONTACT_PHONE=replace-with-support-phone
